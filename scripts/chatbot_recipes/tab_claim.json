{
  "allow_state_change": true,
  "chat": {
    "path": "/REPLACE_CHAT_PATH",
    "encoding": "json",
    "message_field": "message",
    "response_field": "reply"
  },
  "bootstrap": {
    "path": "/REPLACE_CLAIM_PATH",
    "encoding": "json",
    "body": {"force": false},
    "success_status": 200,
    "token_field": "tab_token",
    "chat_field": "tab_token",
    "header": "X-Tab-Token"
  }
}
